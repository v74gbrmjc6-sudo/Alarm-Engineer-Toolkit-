<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>AlarmIQ</title>

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

html, body {
  margin: 0;
  padding: 0;
  background: #050b12;
  color: #fff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

body {
  min-height: 100vh;
  padding-bottom: 90px;
}

header {
  padding: 18px;
  border-bottom: 1px solid #223a52;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo {
  width: 58px;
  height: 58px;
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg,#54a8ff,#2368b8);
  font-size: 23px;
  font-weight: 900;
}

.brand h1 {
  margin: 0;
  font-size: 25px;
}

.brand p {
  margin: 3px 0 0;
  color: #9eb0c3;
  font-size: 12px;
}

main {
  padding: 16px;
}

.view {
  display: none;
}

.view.active {
  display: block;
}

.hero {
  text-align: center;
  padding: 15px 5px 20px;
}

.hero h2 {
  font-size: 30px;
  margin: 5px 0;
}

.hero p {
  color: #9eb0c3;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10px;
}

.card {
  min-height: 135px;
  padding: 15px 10px;
  border-radius: 18px;
  border: 1px solid #223a52;
  background: linear-gradient(145deg,#102033,#09131e);
  color: white;
  text-decoration: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.card:active,
button:active {
  transform: scale(.97);
}

.icon {
  font-size: 32px;
  margin-bottom: 7px;
}

.card h3 {
  margin: 3px 0 5px;
  font-size: 15px;
}

.card p {
  margin: 0;
  color: #9eb0c3;
  font-size: 11px;
}

.section-title {
  margin-bottom: 15px;
}

.section-title h2 {
  margin: 0 0 5px;
  font-size: 25px;
}

.section-title p {
  margin: 0;
  color: #9eb0c3;
}

.home-link {
  display: inline-block;
  margin-bottom: 15px;
  color: #3da9ff;
  text-decoration: none;
  font-weight: 700;
}

.calc-card,
.info-card {
  margin-bottom: 12px;
  padding: 16px;
  border-radius: 18px;
  border: 1px solid #223a52;
  background: linear-gradient(145deg,#102033,#09131e);
}

.calc-card h3,
.info-card h3 {
  margin-top: 0;
}

.calc-card input {
  width: 100%;
  height: 50px;
  margin: 7px 0;
  padding: 12px;
  border-radius: 11px;
  border: 1px solid #304a63;
  background: #050b12;
  color: white;
  font-size: 16px;
}

.calc-card button {
  width: 100%;
  height: 50px;
  margin-top: 8px;
  border: 0;
  border-radius: 11px;
  background: #3da9ff;
  color: #06101a;
  font-size: 15px;
  font-weight: 900;
}

.result {
  margin-top: 10px;
  padding: 11px;
  border-radius: 10px;
  background: #07111b;
  color: #54a8ff;
  font-weight: 800;
}

footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  justify-content: space-around;
  padding: 8px 4px calc(8px + env(safe-area-inset-bottom));
  background: #050b12;
  border-top: 1px solid #223a52;
}

footer a {
  flex: 1;
  padding: 7px 2px;
  color: #9eb0c3;
  text-align: center;
  text-decoration: none;
  font-size: 11px;
}

footer a span {
  display: block;
  font-size: 21px;
  margin-bottom: 2px;
}

footer a.active {
  color: #3da9ff;
}

.warning {
  padding: 13px;
  border-radius: 12px;
  background: #18150c;
  border: 1px solid #59491c;
  color: #d8c47a;
  font-size: 12px;
}
</style>
</head>

<body>

<header>
  <div class="brand">
    <div class="logo">IQ</div>
    <div>
      <h1>AlarmIQ</h1>
      <p>Built for Alarm Engineers</p>
    </div>
  </div>
</header>

<main>

<!-- HOME -->
<section id="home" class="view active">

  <div class="hero">
    <h2>AlarmIQ</h2>
    <p>Your alarm engineer toolkit</p>
  </div>

  <div class="grid">

    <a class="card" href="#devices">
      <div class="icon">🔧</div>
      <h3>Devices</h3>
      <p>Device information</p>
    </a>

    <a class="card" href="#calculators">
      <div class="icon">🧮</div>
      <h3>Calculators</h3>
      <p>Engineering calculations</p>
    </a>

    <a class="card" href="#faults">
      <div class="icon">⚠️</div>
      <h3>Faults</h3>
      <p>Fault finding</p>
    </a>

    <a class="card" href="#systems">
      <div class="icon">🚨</div>
      <h3>Systems</h3>
      <p>Alarm systems</p>
    </a>

    <a class="card" href="#wiring">
      <div class="icon">🔌</div>
      <h3>Wiring</h3>
      <p>Wiring references</p>
    </a>

    <a class="card" href="#battery">
      <div class="icon">🔋</div>
      <h3>Batteries</h3>
      <p>Battery information</p>
    </a>

    <a class="card" href="#regulations">
      <div class="icon">⚖️</div>
      <h3>Regulations</h3>
      <p>UK alarm standards</p>
    </a>

    <a class="card" href="#settings">
      <div class="icon">⚙️</div>
      <h3>Settings</h3>
      <p>App settings</p>
    </a>

  </div>
</section>


<!-- DEVICES -->
<section id="devices" class="view">
<a class="home-link" href="#home">← Home</a>

<div class="section-title">
<h2>🔧 Devices</h2>
<p>Alarm device information</p>
</div>

<div class="grid">
<a class="card" href="#pir">
<div class="icon">👁️</div>
<h3>PIRs</h3>
<p>Motion detectors</p>
</a>

<a class="card" href="#contacts">
<div class="icon">🚪</div>
<h3>Contacts</h3>
<p>Magnetic contacts</p>
</a>

<a class="card" href="#bells">
<div class="icon">🔔</div>
<h3>Sounders</h3>
<p>External sounders</p>
</a>

<a class="card" href="#panic">
<div class="icon">🆘</div>
<h3>Panic</h3>
<p>Panic devices</p>
</a>
</div>
</section>


<!-- CALCULATORS -->
<section id="calculators" class="view">
<a class="home-link" href="#home">← Home</a>

<div class="section-title">
<h2>🧮 Calculators</h2>
<p>Quick engineer calculations</p>
</div>


<div class="calc-card">

<h3>⚡ Voltage Drop</h3>

<input
id="vdCurrent"
type="number"
inputmode="decimal"
step="any"
placeholder="Current (A)"
>

<input
id="vdResistance"
type="number"
inputmode="decimal"
step="any"
placeholder="Resistance (Ω)"
>

<button type="button" id="vdButton">
Calculate
</button>

<div class="result" id="vdResult">
Enter the values above
</div>

</div>


<div class="calc-card">

<h3>🔋 Battery Runtime</h3>

<input
id="batteryAh"
type="number"
inputmode="decimal"
step="any"
placeholder="Battery capacity (Ah)"
>

<input
id="batteryLoad"
type="number"
inputmode="decimal"
step="any"
placeholder="Load (A)"
>

<button type="button" id="batteryButton">
Calculate
</button>

<div class="result" id="batteryResult">
Enter the values above
</div>

</div>


<div class="calc-card">

<h3>Ω Resistance</h3>

<input
id="resVoltage"
type="number"
inputmode="decimal"
step="any"
placeholder="Voltage (V)"
>

<input
id="resCurrent"
type="number"
inputmode="decimal"
step="any"
placeholder="Current (A)"
>

<button type="button" id="resButton">
Calculate
</button>

<div class="result" id="resResult">
Enter the values above
</div>

</div>


<div class="calc-card">

<h3>🔌 Current</h3>

<input
id="currentVoltage"
type="number"
inputmode="decimal"
step="any"
placeholder="Voltage (V)"
>

<input
id="currentResistance"
type="number"
inputmode="decimal"
step="any"
placeholder="Resistance (Ω)"
>

<button type="button" id="currentButton">
Calculate
</button>

<div class="result" id="currentResult">
Enter the values above
</div>

</div>

</section>


<!-- FAULTS -->
<section id="faults" class="view">
<a class="home-link" href="#home">← Home</a>

<div class="section-title">
<h2>⚠️ Faults</h2>
<p>Common alarm faults</p>
</div>

<div class="grid">

<div class="info-card">
<h3>Battery Fault</h3>
<p>Check battery voltage, charging voltage and battery condition.</p>
</div>

<div class="info-card">
<h3>Tamper</h3>
<p>Check covers, wiring, resistors and tamper switches.</p>
</div>

<div class="info-card">
<h3>Bell Fault</h3>
<p>Check sounder wiring, voltage and tamper circuit.</p>
</div>

<div class="info-card">
<h3>Communication</h3>
<p>Check signalling path and network connection.</p>
</div>

</div>
</section>


<!-- SYSTEMS -->
<section id="systems" class="view">
<a class="home-link" href="#home">← Home</a>

<div class="section-title">
<h2>🚨 Systems</h2>
<p>Alarm system references</p>
</div>

<div class="grid">

<div class="info-card">
<h3>Texecom</h3>
<p>Premier and Premier Elite systems.</p>
</div>

<div class="info-card">
<h3>Fire Alarm</h3>
<p>Fire detection and alarm systems.</p>
</div>

<div class="info-card">
<h3>CCTV</h3>
<p>CCTV system information.</p>
</div>

<div class="info-card">
<h3>Signalling</h3>
<p>Alarm transmission and monitoring.</p>
</div>

</div>
</section>


<!-- WIRING -->
<section id="wiring" class="view">
<a class="home-link" href="#home">← Home</a>

<div class="section-title">
<h2>🔌 Wiring</h2>
<p>Quick wiring references</p>
</div>

<div class="info-card">
<h3>General</h3>
<p>Always follow the manufacturer's wiring diagram and the current applicable standard.</p>
</div>

</section>


<!-- BATTERY -->
<section id="battery" class="view">
<a class="home-link" href="#home">← Home</a>

<div class="section-title">
<h2>🔋 Batteries</h2>
<p>Battery reference</p>
</div>

<div class="info-card">
<h3>Standby Capacity</h3>
<p>Use the battery runtime calculator for a quick theoretical estimate. Actual performance depends on battery condition, temperature, load and manufacturer specifications.</p>
</div>

</section>


<!-- REGULATIONS MENU -->
<section id="regulations" class="view">
<a class="home-link" href="#home">← Home</a>

<div class="section-title">
<h2>⚖️ Regulations</h2>
<p>UK alarm standards quick reference</p>
</div>

<div class="grid">

<a class="card" href="#fire-regulations">
<div class="icon">🔥</div>
<h3>Fire Alarm</h3>
<p>BS 5839</p>
</a>

<a class="card" href="#intruder-regulations">
<div class="icon">🚨</div>
<h3>Intruder</h3>
<p>EN 50131</p>
</a>

<a class="card" href="#signalling-regulations">
<div class="icon">📡</div>
<h3>Signalling</h3>
<p>EN 50136</p>
</a>

<a class="card" href="#engineer-regulations">
<div class="icon">📋</div>
<h3>Engineer Checks</h3>
<p>Quick reference</p>
</a>

</div>
</section>


<!-- FIRE REGULATIONS -->
<section id="fire-regulations" class="view">
<a class="home-link" href="#regulations">← Regulations</a>

<div class="section-title">
<h2>🔥 Fire Alarm</h2>
</div>

<div class="info-card">
<h3>BS 5839-1</h3>
<p>Fire detection and alarm systems in non-domestic premises.</p>
</div>

<div class="info-card">
<h3>BS 5839-6</h3>
<p>Fire detection and alarm systems in domestic premises.</p>
</div>

</section>


<!-- INTRUDER REGULATIONS -->
<section id="intruder-regulations" class="view">
<a class="home-link" href="#regulations">← Regulations</a>

<div class="section-title">
<h2>🚨 Intruder Alarms</h2>
</div>

<div class="info-card">
<h3>EN 50131</h3>
<p>Requirements and grades for intruder and hold-up alarm systems.</p>
</div>

<div class="info-card">
<h3>PD 6662</h3>
<p>UK scheme for applying European standards to intruder and hold-up alarm systems.</p>
</div>

<div class="info-card">
<h3>BS 8243</h3>
<p>Installation and configuration guidance for confirmed alarm systems.</p>
</div>

</section>


<!-- SIGNALLING